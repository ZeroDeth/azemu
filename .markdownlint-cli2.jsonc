{
  // Dependencies and build output are not ours to lint. CI has no
  // node_modules so it never saw these, but a local run does, which made the
  // two disagree.
  "ignores": [
    "**/node_modules/**",
    ".flox/**",
    "console/dist/**",
    "internal/console/dist/**"
  ],
  "config": {
    "MD013": false,
    "MD033": false,
    "MD041": false,

    // MD060 (table-column-style) arrived in markdownlint v0.41, which
    // markdownlint-cli2-action v24 bundles. Its default is "consistent": it
    // infers a style per table and enforces that. The docs here are written
    // with leading and trailing pipes and a compact separator row, which the
    // inference reads inconsistently -- it reported 8207 violations, and
    // running --fix moved the goalposts to "aligned", which would pad every
    // cell to column width and wreck the wide Notes column in PARITY.md.
    //
    // Naming the style the docs already use enforces the rule rather than
    // disabling it, and needs no edits to any file: measured across **/*.md,
    // leading_and_trailing gives 0 violations, compact 7591, aligned 21452.
    "MD060": { "style": "leading_and_trailing" }
  }
}
